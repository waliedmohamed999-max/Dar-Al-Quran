# Copy to .env and replace every value outside local development. Never commit .env.

APP_ENV=development                      # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Runtime override of the public URL; NEXT_PUBLIC_ values are fixed at build time.
APP_URL=

# --- PostgreSQL ---
POSTGRES_USER=dar_owner
POSTGRES_PASSWORD=change_me_owner
POSTGRES_DB=dar_quran
POSTGRES_PORT=5544
# Owner connection: migrations, seed, imports, auth tables and background jobs.
DATABASE_URL=postgresql://dar_owner:change_me_owner@localhost:5544/dar_quran
# Restricted role that is subject to row level security: all per-request data access.
# The role is created by the migrations with a placeholder password; set the real one with:
#   ALTER ROLE dar_app PASSWORD '...';
APP_DATABASE_URL=postgresql://dar_app:change_me_app@localhost:5544/dar_quran

# --- Authentication ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 32 bytes base64, encrypts sensitive fields at rest (meeting links).
FIELD_ENCRYPTION_KEY=

# --- S3-compatible private storage ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dar-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Email. In development use Mailpit (http://localhost:8025). ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Dar Al-Quran <no-reply@example.org>"

# --- External Quran content adapters ---
# Tafsir and timing content. Review the provider's terms before production (docs/DATA_LICENSES.md).
QF_API_BASE_URL=https://api.quran.com/api/v4
# Optional OAuth2 client credentials if the provider requires them.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_TOKEN_URL=
CONTENT_CACHE_DAYS=7

# --- AI assistant (off until a key is set and an admin enables it) ---
# Questions and retrieved sources are sent to Anthropic. Review privacy obligations first.
AI_ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Live classes. Self-hosted or JaaS Jitsi domain; read at build time for the CSP. ---
# Public meet.jit.si limits embedded calls, so it is not suitable for production.
LIVE_JITSI_DOMAIN=

# --- Web Push for adhkar reminders. Generate once with: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# --- Optional integrations: leave empty to keep them disabled ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SENTRY_DSN=

# --- Retention (days) ---
RETENTION_RECORDING_DAYS=180
RETENTION_AUDIT_DAYS=730

# Only for local demos: refuses to run when APP_ENV=production.
DEMO_PASSWORD=

# Machine-generated tajweed colours stay hidden in production until the scholarly supervisor decides.
# TAJWEED_COLOURS_APPROVED=true

# Test-only key for npm run ai:eval. Never reuse the production key: the evaluation costs money.
# AI_EVAL_API_KEY=

# Set to true only behind a reverse proxy that appends the client address. Rate limits read it.
# TRUST_PROXY=true
# Second factor for administrators is on in production. false is for isolated test systems only.
# MFA_REQUIRED=true
