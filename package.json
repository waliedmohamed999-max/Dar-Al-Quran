{
  "name": "dar-al-quran",
  "version": "0.1.0",
  "private": true,
  "description": "Dar Al-Quran - Quran teaching and memorization platform",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "quran:fetch": "tsx scripts/quran-fetch.ts",
    "quran:import": "tsx scripts/quran-import.ts",
    "quran:verify": "tsx scripts/quran-verify.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:browsers": "playwright test --project=firefox --project=webkit --project=chrome-real",
    "test:media": "playwright test --project=real-media",
    "test:gate": "playwright test --project=production-gate",
    "backup": "bash scripts/backup.sh",
    "restore:test": "bash scripts/restore-test.sh",
    "db:setup": "tsx scripts/db-setup.ts",
    "docs:api": "tsx scripts/gen-api-docs.ts",
    "content:fetch": "tsx scripts/content-fetch.ts",
    "content:import": "tsx scripts/content-import.ts",
    "content:quotes": "tsx scripts/quotes-check.ts",
    "timing:import": "tsx scripts/timing-import.ts",
    "release:check": "tsx scripts/release-check.ts",
    "ai:eval": "tsx scripts/ai-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "adhan": "^4.4.6",
    "better-auth": "^1.7.14",
    "bidi-js": "^1.1.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "fflate": "^0.8.3",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
