// ---------------- V3: hadith academy ----------------

enum HadithStatus {
  ASSIGNED
  PRACTICING
  READY
  SUBMITTED
  MASTERED
  NEEDS_RETRY
}

model HadithCollection {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleAr       String
  titleEn       String
  descriptionAr String
  sourceName    String
  licenseNote   String
  level         Int      @default(1)
  published     Boolean  @default(false)
  /// The final exam runs on the competition engine, so autosave, audio and appeals are shared.
  finalCompetitionId String? @unique
  createdAt     DateTime @default(now())

  entries HadithEntry[]

  @@map("hadith_collections")
}

model HadithEntry {
  id           String       @id @default(cuid())
  collectionId String
  number       Int
  /// Verbatim source text. Changes only through a reviewed edit.
  text         String
  sha256       String
  narrator     String?
  sourceRef    String?
  topic        String?
  /// Only as transmitted by a named reference. Null means not yet documented.
  grade        String?
  gradeSource  String?
  explanation  String?
  explanationSource String?
  vocabulary   Json?
  benefits     String?
  reviewStatus ReviewStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?

  collection    HadithCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  memorizations HadithMemorization[]
  submissions   HadithSubmission[]

  @@unique([collectionId, number])
  @@map("hadith_entries")
}

model HadithMemorization {
  id           String       @id @default(cuid())
  studentId    String
  hadithId     String
  status       HadithStatus @default(ASSIGNED)
  assignedById String?
  reciteBy     DateTime?    @db.Date
  ease         Float        @default(2.5)
  intervalDays Int          @default(1)
  repetitions  Int          @default(0)
  nextReviewAt DateTime?    @db.Date
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hadith  HadithEntry  @relation(fields: [hadithId], references: [id], onDelete: Cascade)
  reviews HadithReview[]

  @@unique([studentId, hadithId])
  @@index([studentId, nextReviewAt])
  @@map("hadith_memorizations")
}

model HadithSubmission {
  id             String           @id @default(cuid())
  studentId      String
  hadithId       String
  fileId         String?
  status         SubmissionStatus @default(SUBMITTED)
  consentGivenBy String
  deleteAfter    DateTime
  createdAt      DateTime         @default(now())

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hadith  HadithEntry @relation(fields: [hadithId], references: [id], onDelete: Cascade)
  file    File?       @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("hadith_submissions")
}

model HadithReview {
  id                 String         @id @default(cuid())
  memorizationId     String
  studentId          String
  teacherId          String
  memorizationScore  Int
  understandingScore Int
  decision           ReviewDecision
  mistakes           String?
  note               String?
  createdAt          DateTime       @default(now())

  memorization HadithMemorization @relation(fields: [memorizationId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("hadith_reviews")
}

