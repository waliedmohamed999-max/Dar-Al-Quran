model RubricCriterion {
  id          String @id @default(cuid())
  rubricId    String
  labelAr     String
  labelEn     String?
  /// Describes what full marks look like, so judges apply the criterion alike.
  guidanceAr  String
  maxScore    Int
  weight      Int    @default(1)
  sortOrder   Int    @default(0)

  rubric Rubric         @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores JudgingScore[]

  @@map("rubric_criteria")
}

enum JudgingStatus {
  SCHEDULED
  OPEN
  CLOSED
  APPROVED
}

enum JudgingEntryStatus {
  WAITING
  ON_STAGE
  DONE
  ABSENT
}

/// A live oral judging session. Judges score; results count only after a person approves them.
model JudgingSession {
  id            String        @id @default(cuid())
  competitionId String
  rubricId      String
  title         String
  scheduledAt   DateTime
  passPercent   Int           @default(60)
  status        JudgingStatus @default(SCHEDULED)
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())

  competition Competition    @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  rubric      Rubric         @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  judges      JudgingJudge[]
  entries     JudgingEntry[]

  @@index([competitionId])
  @@map("judging_sessions")
}

model JudgingJudge {
  sessionId String
  userId    String

  session JudgingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@map("judging_judges")
}

model JudgingEntry {
  id           String             @id @default(cuid())
  sessionId    String
  studentId    String
  /// Public results use this code, so a participant is not named without consent.
  code         String
  sortOrder    Int
  status       JudgingEntryStatus @default(WAITING)
  finalPercent Int?

  session JudgingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  scores  JudgingScore[]

  @@unique([sessionId, studentId])
  @@unique([sessionId, code])
  @@map("judging_entries")
}

model JudgingScore {
  entryId     String
  judgeId     String
  criterionId String
  score       Int
  note        String?
  updatedAt   DateTime @updatedAt

  entry     JudgingEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@id([entryId, judgeId, criterionId])
  @@map("judging_scores")
}

/// Encrypted TOTP secret and backup codes, managed by the auth library.
model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean? @default(true)
  /// The library locks the factor after repeated wrong codes.
  failedVerificationCount Int? @default(0)
  lockedUntil DateTime?
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_two_factors")
}

/// One row per scholarly decision. Kept when content changes, so the history stays readable.
model ContentReview {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  decision   ReviewStatus
  reason     String?
  reviewerId String
  /// Hash of the exact text the reviewer saw.
  contentSha String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@map("content_reviews")
}

/// The scholar responsible for an item. Assignment does not approve anything.
model ReviewAssignment {
  targetType   String
  targetId     String
  reviewerId   String
  assignedById String
  updatedAt    DateTime @updatedAt

  @@id([targetType, targetId])
  @@map("review_assignments")
}
